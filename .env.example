# MediGraph AI - Environment Configuration Example
#
# Backend configuration lives in backend/.env (copy from backend/.env.example):
#   LLM_API_KEY=your_gemini_api_key_here
#   LLM_MODEL=gemini-3.5-flash-lite
#   DATABASE_URL=sqlite:///./medigraph.db
#   UPLOAD_DIR=../storage/uploads
#   REPORT_DIR=../storage/reports
#   FRONTEND_ORIGIN=http://localhost:5173
#
# Frontend configuration lives in frontend/.env (optional, copy from frontend/.env.example):
#   VITE_API_URL=http://localhost:8000
