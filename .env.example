# MediGraph AI - Deployment & Environment Configuration Template

# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (Configure in Render Dashboard or backend/.env)
# ==============================================================================
# LLM_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-3.5-flash-lite
# APP_ENV=production
# FRONTEND_ORIGIN=https://your-project.vercel.app
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Storage and Database paths (default to local, or specify persistent disk mount):
# DATABASE_URL=sqlite:///./medigraph.db
# UPLOAD_DIR=../storage/uploads
# REPORT_DIR=../storage/reports

# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Dashboard or frontend/.env)
# ==============================================================================
# VITE_API_URL=https://your-backend.onrender.com
