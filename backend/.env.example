# MediGraph AI Backend Environment Variables

# [REQUIRED] Google Gemini API Key (keep secret on backend only)
LLM_API_KEY=put_your_gemini_key_here

# [OPTIONAL] Gemini Model
LLM_MODEL=gemini-3.5-flash-lite

# Environment ('development' or 'production')
APP_ENV=production

# Database Configuration
# Local default: sqlite:///./medigraph.db
# Render with Persistent Disk mounted at /var/data: sqlite:////var/data/medigraph.db
DATABASE_URL=sqlite:///./medigraph.db

# Storage Directories
# Local defaults:
UPLOAD_DIR=../storage/uploads
REPORT_DIR=../storage/reports
# Render with Persistent Disk mounted at /var/data:
# UPLOAD_DIR=/var/data/storage/uploads
# REPORT_DIR=/var/data/storage/reports

MAX_UPLOAD_MB=15
RETENTION_DAYS=7

# Frontend Origin for CORS (comma-separated for multiple origins)
# Set this to your deployed Vercel domain on Render:
# e.g., https://your-project.vercel.app
FRONTEND_ORIGIN=https://your-project.vercel.app

# Optional regex for Vercel preview deployments
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

LOG_LEVEL=INFO
